rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_profiles/{profileId} {
      allow read, write: if true;
    }
    match /user_activity_logs/{logId} {
      allow read, write: if true;
    }
    match /workspaces/{workspaceId} {
      allow read, write: if true;
    }
  }
}
